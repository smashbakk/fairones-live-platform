{
  "expo": {
    "name": "Fair Ones Live",
    "slug": "fairones-live",
    "scheme": "fairones",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070708",
    "newArchEnabled": true,
    "plugins": [
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "media"
          }
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070708"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fairones.live",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Fair Ones uses your camera only when you choose to join or host a live matchup.",
        "NSMicrophoneUsageDescription": "Fair Ones uses your microphone only when you choose to join or host a live matchup.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "android": {
      "package": "com.fairones.live",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070708"
      },
      "permissions": ["CAMERA", "RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS"],
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "extra": {
      "youtubeChannel": "https://www.youtube.com/@FaironesLive",
      "supportEmail": "support@fairones.live",
      "privacyPolicyUrl": "https://fairones.live/privacy",
      "termsUrl": "https://fairones.live/terms",
      "eas": {
        "projectId": "e9c02ff9-38ee-48dc-a6c6-6767a3800229"
      }
    }
  }
}
