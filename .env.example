EXPO_PUBLIC_LIVEKIT_TOKEN_ENDPOINT=https://YOUR-FUNCTION-APP.azurewebsites.net/api/livekit/token
EXPO_PUBLIC_YOUTUBE_VERIFY_ENDPOINT=https://YOUR-FUNCTION-APP.azurewebsites.net/api/youtube/subscription
EXPO_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com

